IdentityFile ~/.ssh/id_ed25519

Host *
    AddKeysToAgent yes
    ForwardAgent yes
    ServerAliveInterval 60
    ServerAliveCountMax 3
    HashKnownHosts yes

# UseKeychain — macOS-only опция (Keychain интеграция)
Match host * exec "uname | grep -q Darwin"
    UseKeychain yes

# github.com
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519
